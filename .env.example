# GOOGLEFLIGHTS environment
#
# Everything works with no configuration at all: token building, decoding,
# mixed-cabin planning and result parsing are all offline.

# --- Live fetch (optional, off by default) -----------------------------------
# Set to 1 to enable POST /api/search, which does one plain GET of the public
# Google Flights results page. Automated querying of Google is against their
# Terms of Service — keep this to low-volume personal research.
GF_LIVE=0

# Minimum milliseconds between live requests (rate limiter). Default 3000.
GF_MIN_INTERVAL_MS=3000

# --- Dev server ---------------------------------------------------------------
PORT=8080
HOST=0.0.0.0
